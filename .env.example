# Copy to .env (git-ignored). Defaults need no changes for the demo.
# Keep one KEY=value per line with no trailing comments.

# rule | ai
SCHEDULING_STRATEGY=rule

# mock | gemini | openai_compatible
LLM_PROVIDER=mock

# the provider's model id
LLM_MODEL=

# openai_compatible: API root or full .../chat/completions URL. gemini: leave empty.
LLM_BASE_URL=

LLM_API_KEY=

# extra "product" header, required by some gateways (e.g. LiteLLM)
LLM_PRODUCT=

# per-call timeout in milliseconds
LLM_TIMEOUT_MS=8000
